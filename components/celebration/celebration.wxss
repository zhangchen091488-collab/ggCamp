.celebration {position:fixed;left:0;right:0;top:0;bottom:0;z-index:20;pointer-events:none;overflow:hidden;}
.canvas {position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;}
/* Everything below is scoped to the DOM fallback. */
.dom-scene {position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;}
/* One tinted wash per finale, so the four celebrations open on a visibly different stage. */
.dom-glow {position:absolute;left:50%;top:44%;z-index:0;width:170%;height:170%;border-radius:50%;transform:translate(-50%,-50%) scale(.4);background:radial-gradient(circle,var(--accent,#ffd23f) 0%,transparent 62%);opacity:0;animation:dom-glow 1.8s cubic-bezier(.16,1,.3,1) both;}
.dom-bit {position:absolute;width:0;height:0;animation:dom-flight var(--life) linear var(--delay) both;}
.dom-shape {position:absolute;left:0;top:0;width:var(--size);height:var(--size);font-size:var(--size);line-height:1;display:flex;align-items:center;justify-content:center;animation:dom-tumble var(--spin) linear var(--delay) infinite;transform-origin:center;}
/* 泡泡 floats without tumbling, matching the canvas theme's `vr = 0`. */
.dom-still {animation-name:none;}
.dom-paper {height:calc(var(--size) * .65);border:1px solid #20234f;border-radius:1px;background:var(--color);}
.dom-coin {border:2px solid #20234f;border-radius:50%;background:#ffd23f;box-shadow:inset 0 0 0 2px #e59b00;}
.dom-star {text-shadow:0 1px #20234f,1px 0 #20234f,-1px 0 #20234f;}
.dom-bubble {border:2px solid var(--color);border-radius:50%;background:#ffffff3d;box-shadow:inset -3px -3px 0 #ffffffee,0 0 6px var(--color);}
.dom-petal {text-shadow:0 1px #20234f;}
.dom-digit,.dom-note {font-weight:900;}
.dom-candy {background:var(--color);border:1px solid #20234f;border-radius:4px;}
.dom-streamer {height:calc(var(--size) * 13);border-radius:5px;background:repeating-linear-gradient(180deg,var(--color) 0,var(--color) 8px,#fff9ee 8px,#fff9ee 10px);animation-name:dom-ribbon;}
.dom-spark {background:var(--color);border-radius:50%;animation:none;}
.dom-mini {height:calc(var(--size) * 1.4);}
.dom-mini-image {width:100%;height:100%;}
.dom-ring {position:absolute;z-index:1;width:var(--diameter);height:var(--diameter);border:3px solid var(--color);border-radius:50%;animation:dom-ring .85s cubic-bezier(.16,1,.3,1) var(--delay) both;}
.dom-actor {position:absolute;z-index:2;transform:translateX(-50%);}
.dom-art,.dom-hop {position:relative;width:100%;height:100%;}
.dom-image {position:absolute;left:0;top:0;width:100%;height:100%;}
.dom-hero {animation:dom-rise .7s cubic-bezier(.22,1,.36,1) var(--enter) both;}
.dom-buddy {animation:dom-buddy-enter .45s cubic-bezier(.22,1,.36,1) var(--enter) both;}
.dom-hop {animation:dom-hop 1.05s ease-in-out calc(var(--enter,0ms) + var(--phase,0ms)) infinite;}
.dom-hero .dom-hop {animation-delay:calc(var(--enter,0ms) + 700ms);}
.dom-stamp {position:absolute;left:50%;top:20%;z-index:4;white-space:nowrap;font-size:var(--stamp-size);font-weight:900;line-height:1.2;color:var(--accent,#ffd23f);text-shadow:-2px -2px #20234f,2px -2px #20234f,-2px 2px #20234f,2px 2px #20234f,-3px 0 #20234f,3px 0 #20234f,0 -3px #20234f,0 3px #20234f;animation:dom-stamp .3s cubic-bezier(.16,1,.3,1) var(--stamp-delay) both;}
.dom-rocket {position:absolute;left:0;top:0;z-index:2;width:190px;height:120px;animation:dom-rocket 1.4s linear both;}
.dom-rocket-image {position:absolute;width:100%;height:100%;}
.dom-rocket-pilot {position:absolute;left:45px;top:-70px;width:90px;height:126px;transform:rotate(12deg);}
.dom-flame {position:absolute;left:8px;top:58px;width:42px;height:18px;border-radius:70% 15% 15% 70%;background:#ffd23f;box-shadow:inset 9px 0 #ff7ab6;animation:dom-flame .12s ease-in-out infinite alternate;}
.dom-parader {position:absolute;z-index:2;animation:dom-parade 2.3s linear both;}
.dom-banner {position:absolute;left:50%;top:-25px;white-space:nowrap;transform:translateX(-50%);padding:4px 10px;font-size:18px;font-weight:900;border:2px solid #20234f;border-radius:10px;color:#20234f;background:#ffd23f;}
.dom-paused view {animation-play-state:paused !important;}
@keyframes dom-flight {
  0% {transform:translate(0,0);opacity:0;}
  2% {opacity:1;}
  20% {transform:translate(var(--x1),var(--y1));}
  40% {transform:translate(var(--x2),var(--y2));}
  60% {transform:translate(var(--x3),var(--y3));opacity:1;}
  80% {transform:translate(var(--x4),var(--y4));opacity:.85;}
  100% {transform:translate(var(--x5),var(--y5));opacity:0;}
}
@keyframes dom-tumble {
  0% {transform:rotate(0deg) scaleX(1);}
  25% {transform:rotate(calc(var(--turn) * .25)) scaleX(.15);}
  50% {transform:rotate(calc(var(--turn) * .5)) scaleX(-1);}
  75% {transform:rotate(calc(var(--turn) * .75)) scaleX(-.15);}
  100% {transform:rotate(var(--turn)) scaleX(1);}
}
@keyframes dom-ribbon {0%,100% {transform:rotate(-16deg) scaleX(.8);} 50% {transform:rotate(24deg) scaleX(1);}}
@keyframes dom-ring {0% {transform:translate(-50%,-50%) scale(.05);opacity:1;} 100% {transform:translate(-50%,-50%) scale(1);opacity:0;}}
@keyframes dom-glow {0% {opacity:0;transform:translate(-50%,-50%) scale(.4);} 35% {opacity:.5;} 100% {opacity:.26;transform:translate(-50%,-50%) scale(1);}}
@keyframes dom-rise {0% {transform:translate(-50%,120%) rotate(-5deg);opacity:0;} 5% {opacity:1;} 100% {transform:translate(-50%,0) rotate(0);opacity:1;}}
@keyframes dom-buddy-enter {0% {transform:translate(-50%,80%);opacity:0;} 100% {transform:translate(-50%,0);opacity:1;}}
@keyframes dom-hop {0%,100% {transform:translateY(0) rotate(-2deg);} 50% {transform:translateY(calc(var(--hop) * -1)) rotate(2deg);}}
@keyframes dom-stamp {0% {transform:translateX(-50%) scale(.6);opacity:0;} 100% {transform:translateX(-50%) scale(1);opacity:1;}}
@keyframes dom-rocket {
  0% {transform:translate(var(--rx0),var(--ry0)) rotate(-28deg);opacity:1;}
  25% {transform:translate(var(--rx1),var(--ry1)) rotate(-28deg);}
  50% {transform:translate(var(--rx2),var(--ry2)) rotate(-28deg);}
  75% {transform:translate(var(--rx3),var(--ry3)) rotate(-28deg);opacity:1;}
  100% {transform:translate(var(--rx4),var(--ry4)) rotate(-28deg);opacity:0;}
}
@keyframes dom-flame {from {transform:scaleX(.7);} to {transform:scaleX(1.2);}}
@keyframes dom-parade {0% {transform:translateX(var(--from));opacity:1;} 99% {opacity:1;} 100% {transform:translateX(var(--to));opacity:0;}}
@media (prefers-reduced-motion:reduce) {
  .dom-bit,.dom-ring,.dom-rocket,.dom-parader {display:none;}
  .dom-glow {animation:none;opacity:.2;transform:translate(-50%,-50%) scale(1);}
  .dom-hop,.dom-hero,.dom-buddy,.dom-stamp {animation:none;}
  .dom-hero,.dom-buddy,.dom-stamp {transform:translateX(-50%);opacity:1;}
}
