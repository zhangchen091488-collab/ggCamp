<view class="cal-card {{motion ? 'moving' : ''}}">
  <view class="cal-head"><button class="cal-nav" data-delta="-1" bindtap="move" aria-label="上个月">‹</button><text class="cal-title">{{title}}</text><button class="cal-nav {{nextDisabled ? 'disabled' : ''}}" data-delta="1" disabled="{{nextDisabled}}" bindtap="move" aria-label="下个月">›</button></view>
  <view class="cal-badges"><view class="badge {{streak >= 3 ? 'hot' : ''}}"><block wx:if="{{streak}}">连续 <text class="number">{{streak}}</text> 日<text wx:if="{{!playedToday}}">（今天第{{streak + 1}}日）</text></block><block wx:else>今天开始积累连续练习记录</block></view><view wx:if="{{bestStreak >= 2}}" class="badge best">最佳 <text class="number">{{bestStreak}}</text> 日</view><view wx:if="{{totalStickers}}" class="badge stickers">贴纸 <text class="number">{{totalStickers}}</text> 张</view><view class="badge hammers" aria-label="补签锤 {{hammers}} 把"><image class="hammer-icon" src="{{hammerImage}}"/><text class="number">{{hammers}}</text> 把</view></view>
  <view class="week"><text class="weekday weekday-{{index}}" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
  <view class="grid"><view wx:for="{{cells}}" wx:key="key" class="day {{item.empty ? 'blank' : ''}} {{item.today ? 'today' : ''}} {{item.played ? 'played' : ''}} {{item.noCount ? 'nocount' : ''}}" data-key="{{item.key}}" bindtap="inspect" aria-role="{{item.played ? 'button' : 'text'}}" aria-label="{{item.label}}"><block wx:if="{{!item.empty}}"><text class="day-number">{{item.day}}</text><image wx:if="{{item.stamp}}" class="stamp" src="{{item.stamp}}"/><text wx:if="{{item.played}}" class="score {{item.best.length >= 5 ? 'large' : ''}}">{{item.best}}</text><image wx:if="{{item.sticker}}" class="sticker" src="{{item.sticker}}"/><text wx:if="{{item.quest}}" class="quest-star">★</text><text wx:if="{{item.noCount}}" class="nc">补签</text></block></view></view>
</view>
<view wx:if="{{showSignIn}}" class="signin"><view class="signin-title">连续签到 {{run}} 天</view><view class="slots"><view wx:for="{{slots}}" wx:key="day" class="slot {{item.got ? 'got' : ''}} {{item.today && motion ? 'stamping' : ''}}"><text>第 {{item.day}} 天</text><image class="slot-image" wx:if="{{item.got}}" src="{{item.image}}"/><text wx:else class="unknown">{{item.day === 7 ? '？' : item.day}}</text></view></view><view class="signin-note">每天首次打开领取贴纸，第 7 天是特别贴纸。完成今日任务可获得补签锤。</view></view>
<view wx:if="{{selected}}" class="modal-shade" catchtap="close" catchtouchmove="noop"><view class="day-log" catchtap="noop" aria-role="dialog" aria-label="{{selected.title}}"><view class="log-title">{{selected.title}}</view><scroll-view scroll-y class="logs"><view wx:for="{{selected.entries}}" wx:key="id" class="log"><text class="time">{{item.time}}</text><text class="mode">{{item.mode}}</text><text class="log-score">{{item.score}}分</text><view class="detail">{{item.detail}}</view></view></scroll-view><button class="close" bindtap="close">关闭</button></view></view>
