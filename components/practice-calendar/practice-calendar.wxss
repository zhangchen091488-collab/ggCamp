.cal-card { padding: 20rpx 20rpx 24rpx; border: 5rpx solid #20234f; border-radius: 38rpx; background: #fff; box-shadow: 0 10rpx 0 #20234f; color: #20234f; }
.cal-head { display: flex; align-items: center; justify-content: space-between; }.cal-title { font-family: Chunky,sans-serif; font-size: 34rpx; font-weight: 900; }.cal-nav { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; padding: 0; margin: 0; border: 4rpx solid #20234f; border-radius: 50%; background: #fff9ee; color: #20234f; font-size: 44rpx; line-height: 1; font-weight: 900; }.cal-nav::after,.close::after { border: none; }.cal-nav.disabled { opacity: .3; }.cal-nav:active { transform: translateY(3rpx); }
.cal-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin: 12rpx 0 18rpx; }.badge { display: flex; align-items: baseline; gap: 5rpx; padding: 4rpx 15rpx; border: 4rpx solid #20234f; border-radius: 50rpx; font-size: 20rpx; font-weight: 800; background: #fff; }.number { font-family: Chunky,sans-serif; font-size: 31rpx; color: #ed75a8; }.hot { background: linear-gradient(90deg,#ffd23f,#ff9a3c); }.hot .number { color: #20234f; }.best .number,.hammers .number { color: #3b6bff; }.stickers .number { color: #ffb000; }.hammers { align-items: center; }.hammer-icon { width: 36rpx; height: 36rpx; transform: rotate(-20deg); }
.week,.grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 5rpx; }.week { margin-bottom: 6rpx; }.weekday { text-align: center; font-size: 19rpx; font-weight: 800; opacity: .6; }.weekday-0 { color: #ff4f6d; }.weekday-6 { color: #3b6bff; }
.day { position: relative; height: 84rpx; border-radius: 16rpx; background: #fff9ee; font-size: 20rpx; font-weight: 900; }.blank { background: transparent; }.today { box-shadow: inset 0 0 0 4rpx #3b6bff; }.played { background: #fff0f6; }.day-number { position: absolute; left: 6rpx; top: 3rpx; opacity: .55; }.stamp { position: absolute; left: 6%; top: 8%; width: 88%; height: 90%; }.score { position: absolute; left: 0; right: 0; bottom: 17%; font-family: Chunky,sans-serif; text-align: center; color: #ff4f6d; font-size: 21rpx; text-shadow: 2rpx 0 #fff,-2rpx 0 #fff,0 2rpx #fff,0 -2rpx #fff; }.score.large { font-size: 17rpx; }.sticker { position: absolute; width: 44%; height: 44%; top: 2rpx; right: 2rpx; }.quest-star { position: absolute; bottom: 2rpx; left: 3rpx; width: 23rpx; height: 23rpx; border: 2rpx solid #20234f; border-radius: 50%; background: #ffd23f; font-size: 16rpx; text-align: center; line-height: 22rpx; }.nocount { background: #efe8ff; }.nc { position: absolute; left: 18%; top: 42%; transform: rotate(-14deg); padding: 2rpx 4rpx; border: 3rpx solid #7a4bff; border-radius: 7rpx; background: #ffffffbb; color: #7a4bff; font-size: 17rpx; }.moving .played:active { animation: stamp .35s ease-out; }@keyframes stamp { 45% { transform: scale(1.12) rotate(-7deg); } }
.signin { margin-top: 28rpx; }.signin-title { font-size: 28rpx; font-weight: 900; }.slots { display: flex; gap: 6rpx; margin: 18rpx 0; }.slot { flex: 1; min-width: 0; border: 3rpx solid #20234f; border-radius: 12rpx; background: #fff; padding: 12rpx 0; text-align: center; font-size: 17rpx; }.slot-image { display: block; margin: 10rpx auto 0; width: 54rpx; height: 54rpx; }.slot.got { background: #fff3c4; }.unknown { display: block; font-family: Chunky,sans-serif; font-size: 38rpx; opacity: .3; }.stamping .slot-image { animation: stamp .6s ease-out; }.signin-note { font-size: 24rpx; line-height: 1.6; color: #565a79; }
.modal-shade { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; padding: 30rpx; background: #101637b8; }.day-log { width: 100%; max-width: 660rpx; padding: 30rpx; box-sizing: border-box; border: 5rpx solid #20234f; border-radius: 36rpx; background: #fff9ee; box-shadow: 0 12rpx #20234f; }.log-title { font-size: 34rpx; font-weight: 900; margin-bottom: 20rpx; }.logs { height: 50vh; }.log { display: flex; flex-wrap: wrap; gap: 8rpx; align-items: baseline; border-bottom: 2rpx dashed #20234f33; padding: 16rpx 0; }.time { width: 80rpx; color: #565a79; font-size: 22rpx; }.mode { flex: 1; font-size: 26rpx; font-weight: 800; }.log-score { font-family: Chunky,sans-serif; color: #ed75a8; font-size: 28rpx; }.detail { width: 100%; margin-left: 88rpx; font-size: 22rpx; color: #565a79; line-height: 1.6; }.close { margin-top: 24rpx; padding: 16rpx; border: 4rpx solid #20234f; border-radius: 20rpx; color: #20234f; background: #fff; font-size: 28rpx; font-weight: 800; }
