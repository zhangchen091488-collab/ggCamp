.stage { position: relative; height: 320rpx; overflow: hidden; border-radius: 32rpx; isolation: isolate; }.effects { position: absolute; width: 100%; height: 100%; left:0; top:0; z-index:0; pointer-events:none; }.hero { position:absolute;left:27%;bottom:0;width:46%;height:100%;z-index:2;transform-origin:center 90%; }.portrait,.wear { position:absolute;width:100%;height:100%;left:0;top:0; }.compact {height:180rpx;}.compact .hero {left:32%;width:36%;}.burst-rays {position:absolute;width:270rpx;height:270rpx;left:calc(50% - 135rpx);top:40rpx;border-radius:50%;background:repeating-conic-gradient(from 0deg,#ffd23f55 0deg 14deg,transparent 14deg 28deg);}.canvas-ready .burst-rays,.canvas-ready .hero,.canvas-ready .crowd,.canvas-ready .mark,.canvas-ready .rocket,.canvas-ready .parade-cart {display:none;}.bg-night,.bg-space {background:#252650;}.bg-sea {background:#d9f7ff;}.bg-festival {background:#ffe4c8;}.bg-paper {background:#e8edff;}
.crowd {position:absolute;inset:0;z-index:1;}.buddy {position:absolute;bottom:0;width:23%;height:66%;opacity:.9;transform-origin:center bottom;}.moving .buddy {animation:buddy-hop 1.3s ease-in-out infinite;}.crowd-twins .buddy {height:58%;}.mark {position:absolute;right:8%;top:8%;width:110rpx;height:110rpx;z-index:3;transform:rotate(-8deg);}.moving.burst .mark {animation:mark-stamp .65s ease-out both;}
.moving .hero {animation:idle 2s ease-in-out infinite;}.moving.burst .hero {animation:hop .65s ease-out;}.moving.preview-costume .hero,.moving.preview-color .hero {animation:turn-hop 2.6s ease-in-out infinite;}.moving .burst-rays {animation:spin 12s linear infinite;}.moving.finale-classic .hero {animation:grand-hop 1.5s ease-in-out infinite;}.moving.finale-rocket .hero {animation:rocket-flight 3s ease-in-out infinite;}.moving.finale-parade .crowd {animation:parade 4s linear infinite;}
.rocket {position:absolute;left:calc(50% - 42rpx);bottom:18rpx;width:80rpx;height:190rpx;border:4rpx solid #20234f;border-radius:60% 60% 18% 18%;background:#fff9ee;z-index:1;transform:rotate(30deg);}.rocket-window {width:37rpx;height:37rpx;margin:55rpx auto 0;border:4rpx solid #20234f;border-radius:50%;background:#8fb4ff;}.rocket-flame {position:absolute;left:15rpx;bottom:-60rpx;width:45rpx;height:75rpx;border-radius:0 0 70% 70%;background:linear-gradient(#ff4f6d,#ffd23f);}.moving .rocket {animation:rocket-flight 3s ease-in-out infinite;}.moving .rocket-flame {animation:flame .2s alternate infinite;}.parade-cart {position:absolute;left:27%;bottom:13rpx;width:46%;height:55rpx;background:#ff7ab6;border:4rpx solid #20234f;border-radius:15rpx;z-index:1;}.cart-wheel {position:absolute;width:30rpx;height:30rpx;bottom:-20rpx;left:15rpx;border:3rpx solid #20234f;border-radius:50%;background:#ffd23f;}.wheel-right {left:auto;right:15rpx;background:#8fb4ff;}.moving .parade-cart {animation:parade 4s linear infinite;}
@keyframes idle {50% {transform:translateY(calc(-5rpx * var(--motion,1))) rotate(calc(1.5deg * var(--motion,1)));}}@keyframes hop {45% {transform:translateY(calc(-35rpx * var(--motion,1))) rotate(calc(-6deg * var(--motion,1)));}}@keyframes turn-hop {25% {transform:translateY(calc(-18rpx * var(--motion,1))) rotate(calc(-7deg * var(--motion,1)));}70% {transform:rotate(calc(5deg * var(--motion,1)));}}@keyframes grand-hop {45% {transform:translateY(calc(-20rpx * var(--motion,1))) scale(1.08);}}@keyframes buddy-hop {50% {transform:translateY(calc(-12rpx * var(--motion,1))) rotate(calc(5deg * var(--motion,1)));}}@keyframes mark-stamp {0% {transform:scale(2) rotate(-20deg);opacity:0;}35% {transform:scale(.9) rotate(-8deg);opacity:1;}100% {transform:scale(1) rotate(-8deg);opacity:1;}}@keyframes spin {to {transform:rotate(360deg);}}@keyframes rocket-flight {50% {transform:translate(calc(45rpx * var(--motion,1)),calc(-45rpx * var(--motion,1))) rotate(calc(18deg * var(--motion,1)));}}@keyframes flame {to {transform:scaleY(.7);}}@keyframes parade {50% {transform:translateX(calc(40rpx * var(--motion,1)));}}
