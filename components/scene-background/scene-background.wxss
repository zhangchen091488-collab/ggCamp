.scene { position:fixed;left:0;right:0;top:0;bottom:0;z-index:0;overflow:hidden;pointer-events:none;background:#fff9ee; }
.paper-grid {position:absolute;inset:0;background-image:linear-gradient(#20234f12 1px,transparent 1px),linear-gradient(90deg,#20234f12 1px,transparent 1px);background-size:36rpx 36rpx;}
.rays {position:absolute;left:50%;top:38%;width:240vh;height:240vh;margin:-120vh;border-radius:50%;background:repeating-conic-gradient(#ffe7a64d 0deg 10deg,transparent 10deg 23deg,#ffe6ed4d 23deg 33deg,transparent 33deg 45deg);}.moving .rays {animation:spin 50s linear infinite;}
.bg-night {background:radial-gradient(ellipse at 50% 40%,#424778,#191b45);}.bg-space {background:radial-gradient(ellipse at 50% 40%,#625491,#191b45);}.bg-night .paper-grid,.bg-space .paper-grid {opacity:.12;}.star {position:absolute;border-radius:50%;background:#fff2d9;box-shadow:0 0 8px #fff2d9aa;opacity:.6;}.moving .star {animation:twinkle 3s ease-in-out infinite;}.planet {position:absolute;right:6%;top:22%;width:90rpx;height:90rpx;border-radius:50%;background:#ffd23f;transform:rotate(28deg);}.orbit {position:absolute;left:-24rpx;top:24rpx;width:130rpx;height:30rpx;border:7rpx solid #b793ff;border-radius:50%;}.moving .planet {animation:planet-float 8s ease-in-out infinite;}
.bg-sea {background:linear-gradient(#e1fcff,#8cd6e5);}.bg-sea .paper-grid {opacity:.25;}.bubble {position:absolute;border:2px solid #ffffffa6;border-radius:50%;background:#ffffff0a;}.bubble-glint {position:absolute;left:15%;top:12%;width:24%;height:30%;border-left:2px solid #ffffffbb;border-radius:50%;transform:rotate(35deg);}.moving .bubble {animation:rise 9s ease-in-out infinite;}
.bg-festival {background:#fff2d9;}.flags {position:absolute;left:-2%;top:3%;width:104%;display:flex;justify-content:space-around;border-top:2px solid #20234f;transform:rotate(-3deg);}.flag {width:50rpx;height:60rpx;clip-path:polygon(0 0,100% 0,50% 100%);background:#ff7ab6;}.flag-1 {background:#ffd23f;}.flag-2 {background:#3fdcb0;}.flag-3 {background:#8faaff;}.flag-4 {background:#b793ff;}.moving .flag {animation:flag-wave 2s ease-in-out infinite;transform-origin:top center;}.lantern {position:absolute;top:20%;width:62rpx;height:90rpx;border:3rpx solid #20234f;border-radius:45%;background:#ff8fac;}.lantern::after {content:'';position:absolute;left:44%;top:100%;width:8rpx;height:32rpx;background:#ffd23f;}.left {left:4%;}.right {right:4%;background:#ffd23f;}.moving .lantern {animation:float 4s ease-in-out infinite;}
.bg-paper {background:#f1eaff;}.fold {position:absolute;width:100rpx;height:76rpx;border:2rpx solid #20234f22;}.fold-light {position:absolute;inset:0;clip-path:polygon(0 0,100% 0,50% 50%);background:#ffffff66;}.moving .fold {animation:fold-float 9s ease-in-out infinite;}
@keyframes spin {to {transform:rotate(360deg);}}@keyframes twinkle {50% {opacity:.2;transform:scale(.7);}}@keyframes rise {50% {transform:translate(12px,-90px);opacity:.35;}}@keyframes float {50% {transform:translateY(-12px);}}@keyframes planet-float {50% {transform:translateY(-12px) rotate(28deg);}}@keyframes fold-float {50% {transform:translateY(-12px) rotate(var(--fold-angle));}}@keyframes flag-wave {50% {transform:skewX(10deg);}}
