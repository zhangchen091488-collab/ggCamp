<view class="quests"><view class="quest-head"><text class="title">今日任务</text><text class="reward">{{allDone ? '全部完成！' : '全部完成得'}}</text><image wx:if="{{!allDone}}" class="hammer" src="/assets/ui/hammer.png"/><text wx:if="{{!allDone}}" class="reward">+1</text></view><view wx:for="{{rows}}" wx:key="id" class="quest {{item.done ? 'done' : ''}}"><view class="progress" style="transform:scaleX({{item.percent / 100}})"></view><view class="line"><text class="tick">{{item.done ? '✓' : '○'}}</text><text class="name">{{item.text}}</text><text class="count">{{item.prog}}/{{item.goal}}</text></view></view></view>
