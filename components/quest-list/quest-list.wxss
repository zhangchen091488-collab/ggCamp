.quests { padding: 22rpx; border: 5rpx solid #20234f; border-radius: 38rpx; background: #fffbe0; box-shadow: 0 10rpx #20234f; color: #20234f; }.quest-head { display: flex; align-items: center; gap: 7rpx; margin-bottom: 15rpx; }.title { flex: 1; font-size: 30rpx; font-weight: 900; }.reward { font-size: 21rpx; font-weight: 800; color: #ed75a8; }.hammer { width: 31rpx; height: 31rpx; transform: rotate(-20deg); }.quest { margin-top: 10rpx; position: relative; overflow: hidden; padding: 10rpx 12rpx; border: 4rpx solid #20234f; border-radius: 19rpx; background: #fff; }.progress { position: absolute; inset: 0; background: #fff3c4; transform-origin: left; transition: transform .35s ease-out; }.done .progress { background: #d8fff0; }.line { position: relative; display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; font-weight: 800; }.tick { color: #a9a7bb; font-size: 27rpx; }.done .tick { color: #45ba96; }.name { flex: 1; }.count { white-space: nowrap; font-family: Chunky,sans-serif; font-size: 22rpx; }
