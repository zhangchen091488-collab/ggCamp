<view class="container paper"><view class="heading">奖杯 {{count}}/{{total}}</view><view class="filters"><button wx:for="{{filters}}" wx:key="*this" class="{{filter === item ? 'secondary' : ''}}" data-type="filter" data-value="{{item}}" bindtap="filter">{{item}}</button></view><scroll-view scroll-x class="cat-scroll"><view class="cats"><button wx:for="{{cats}}" wx:key="*this" class="{{cat === item ? 'secondary' : ''}}" data-type="cat" data-value="{{item}}" bindtap="filter">{{item}}</button></view></scroll-view><view wx:if="{{selected}}" class="detail"><view class="heading">{{selected.name}}</view><view>{{selected.desc}}</view><view class="muted">{{selected.earned ? '已获得' : '进度 ' + selected.progress}}</view><view wx:if="{{selected.reward}}">奖励收藏：{{selected.reward}}</view><button bindtap="close">收起</button></view><view wx:for="{{groups}}" wx:key="key" class="series"><view class="series-head"><text>{{item.title}}</text><text>{{item.got}}/{{item.total}}</text></view><view class="muted">下一个：{{item.next}}</view><view class="track"><view style="width:{{item.percent}}%"></view></view><view class="badges"><button wx:for="{{item.items}}" wx:for-item="trophy" wx:key="id" class="{{trophy.earned ? 'earned' : 'locked'}}" data-id="{{trophy.id}}" bindtap="inspect"><view>{{trophy.earned ? '🏆' : '◇'}} {{trophy.rank}}</view><text>{{trophy.name}}</text></button></view></view><view wx:if="{{!groups.length}}" class="muted">这里还没有奖杯，继续练习吧！</view></view>