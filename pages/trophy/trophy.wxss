 .heading { font-size: 44rpx; } .filters,.cats { display: flex; gap: 12rpx; margin: 24rpx 0; } .filters { flex-wrap: wrap; } .filters button,.cats button { padding: 12rpx 18rpx; font-size: 25rpx; white-space: nowrap; } .cats { width: max-content; margin-top: 0; } .cat-scroll { width: 100%; } .series { margin: 24rpx 0; padding-bottom: 24rpx; border-bottom: 2rpx solid #20234f22; } .series-head { display: flex; justify-content: space-between; font-size: 32rpx; font-weight: 800; } .track { margin: 12rpx 0; background: #e8e6ed; height: 10rpx; border-radius: 8rpx; overflow: hidden; } .track view { background: #ef8bb6; height: 100%; } .badges { display: flex; flex-wrap: wrap; gap: 12rpx; } .badges button { width: calc((100% - 24rpx) / 3); font-size: 22rpx; padding: 16rpx 8rpx; border-width: 2rpx; } .badges button view { margin-bottom: 8rpx; } .earned { background: #fff0ab; } .locked { color: #686b85; background: #eeedf4; } .detail { padding: 24rpx; border: 4rpx solid #20234f; border-radius: 24rpx; background: #fff0ab; } .detail .heading { font-size: 36rpx; } .detail button { margin-top: 20rpx; }