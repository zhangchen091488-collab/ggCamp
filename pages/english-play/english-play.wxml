<scene-background show="{{show}}"/>
<celebration show="{{show}}" mode="{{paused ? '' : 'burst'}}"/>
<view class="container paper english-play"><view class="progress">英语试用 · 第 {{number}} / {{total}} 题</view><view class="muted">{{packTitle}}</view><view class="english-growth">连击 {{combo}} · 欢乐值 {{dopa}}</view><view class="english-stage"><show-stage wx:if="{{stageReady}}" compact="{{compactStage}}" show="{{show}}" quiet particles="{{false}}"/></view>
  <view class="card"><view class="card-heading"><view class="tag">{{phase === 'learn' ? '先认识它' : inputMethod === 'cards' ? '看中文，拼英文' : '看中文，写英文'}}</view><view wx:if="{{phase === 'answer'}}" class="answer-tools"><button class="symbol-button hint-button" bindtap="hint" aria-label="{{inputMethod === 'cards' ? '提示当前字母卡' : '随机字母提示'}}">?</button><button class="symbol-button" bindtap="skip" aria-label="不会，查看答案"><view class="eye-icon"><view class="eye-pupil"/></view></button></view></view><view class="prompt">{{prompt}}</view><view class="pronunciation-row"><view class="phonetics"><text wx:if="{{phoneticUk}}">英音 {{phoneticUk}}</text><text wx:if="{{phoneticUs}}">美音 {{phoneticUs}}</text></view><button class="pronunciation-icon" disabled="{{paused || !canListen || !canListenSlow}}" bindtap="listen" aria-label="播放正常读音和慢读"><view class="speaker-icon"/></button></view>
    <block wx:if="{{phase === 'learn'}}"><view class="canonical">{{canonical}}</view><view class="muted">读一读，记一记。当前词表尚未完成释义与单元审核。</view><button class="primary" bindtap="learned">我记住了，开始默写</button></block>
    <block wx:else><view class="answer-cells {{inputMethod === 'cards' ? 'card-answer-cells' : ''}}" aria-label="逐字母填写答案"><block wx:if="{{inputMethod === 'cards'}}"><view wx:for="{{wordCells}}" wx:key="id" wx:for-item="word" class="answer-word"><view wx:for="{{word.cells}}" wx:key="index" id="answer-cell-{{item.index}}" data-index="{{item.index}}" bindtap="selectCell" class="letter-cell {{pulseCell === item.index ? 'cell-pop' : ''}} {{item.fixed ? 'fixed-cell' : ''}} {{item.space ? 'word-space' : ''}} {{item.active && phase === 'answer' ? 'active-cell' : ''}} {{!item.value && item.hint ? 'hint-cell' : ''}}"><text wx:if="{{item.value || item.hint}}">{{item.value || item.hint}}</text><text wx:elif="{{item.active && phase === 'answer' && !item.space && !item.fixed}}" class="cell-question">?</text></view></view></block><block wx:else><view wx:for="{{cells}}" wx:key="index" id="answer-cell-{{item.index}}" data-index="{{item.index}}" bindtap="selectCell" class="letter-cell {{pulseCell === item.index ? 'cell-pop' : ''}} {{item.fixed ? 'fixed-cell' : ''}} {{item.space ? 'word-space' : ''}} {{item.active && phase === 'answer' ? 'active-cell' : ''}} {{!item.value && item.hint ? 'hint-cell' : ''}}"><text wx:if="{{item.value || item.hint}}">{{item.value || item.hint}}</text><text wx:elif="{{item.active && phase === 'answer' && !item.space && !item.fixed}}" class="cell-question">?</text></view></block></view><view class="feedback">{{feedback}}</view><view wx:if="{{phase === 'answer' && edits.length}}" class="differences"><text wx:for="{{edits}}" wx:key="id" class="edit-{{item.kind}}">{{item.display}}</text></view><view wx:if="{{hintText}}" class="muted">{{hintText}}</view></block>
  </view>
  <view wx:if="{{phase !== 'learn' && inputMethod === 'cards'}}" class="cards-dock input-dock">
    <view class="cards-caption">{{phase === 'feedback' ? '拼好了！' : '按顺序点字母卡'}}<text wx:if="{{wordCount > 1}}">第 {{wordNumber}} / {{wordCount}} 个词</text></view>
    <view class="letter-pool"><button wx:for="{{cards}}" wx:key="id" class="letter-tile tile-tone-{{index % 6}} {{item.used ? 'consumed-tile' : ''}} {{wrongCard === item.id ? 'wrong-tile' : ''}} {{wrongCard === item.id && show.motion ? 'shake-tile' : ''}} {{hintCard === item.id ? 'hint-tile' : ''}}" disabled="{{paused || phase !== 'answer' || item.used}}" data-tone="{{index % 6}}" data-id="{{item.id}}" data-question="{{questionId}}" bindtap="tapCard" hover-class="{{show.motion ? 'tile-pressed' : 'none'}}" aria-label="{{item.used ? '已使用' : item.letter}}">{{item.used ? '' : item.letter}}</button></view>
    <button wx:if="{{phase === 'feedback'}}" class="primary cards-next" bindtap="next">{{number === total ? '查看成绩' : '下一题 →'}}</button>
  </view>
  <view wx:if="{{phase !== 'learn' && inputMethod !== 'cards'}}" class="keyboard input-dock">
    <view class="key-row"><button wx:for="{{shift ? upperRows[0] : rows[0]}}" wx:key="*this" disabled="{{phase !== 'answer'}}" data-key="{{item}}" bindtap="key">{{item}}</button></view>
    <view class="key-row"><button wx:for="{{shift ? upperRows[1] : rows[1]}}" wx:key="*this" disabled="{{phase !== 'answer'}}" data-key="{{item}}" bindtap="key">{{item}}</button></view>
    <view class="key-row"><button class="modifier-key {{shift ? 'shift-on' : ''}}" disabled="{{phase !== 'answer'}}" data-key="shift" bindtap="key" aria-label="切换大小写"><view class="shift-icon"><view class="shift-chevron"/><view class="shift-bar"/></view></button><button wx:for="{{shift ? upperRows[2] : rows[2]}}" wx:key="*this" disabled="{{phase !== 'answer'}}" data-key="{{item}}" bindtap="key">{{item}}</button><button class="modifier-key" disabled="{{phase !== 'answer'}}" data-key="backspace" bindtap="key" bindlongpress="clearAnswer" aria-label="删除，长按清空"><view class="backspace-icon"/></button></view>
    <view class="key-row punctuation-row"><button wx:for="{{punctuation}}" wx:key="*this" disabled="{{phase !== 'answer'}}" data-key="{{item}}" bindtap="key">{{item}}</button><button wx:if="{{phase === 'feedback'}}" class="primary submit-key" bindtap="next">{{number === total ? '查看成绩' : '下一题 →'}}</button><button wx:else class="primary submit-key" bindtap="submit">提交</button></view>
  </view>
  <view wx:if="{{warning}}" class="warning">{{warning}}<button bindtap="retrySave">重试保存</button></view>
</view>
<view wx:if="{{paused}}" class="pause-shade" catchtouchmove="noop"><view class="card"><view class="prompt">准备好继续了吗？</view><view class="muted">答案与进度已经保留。</view><button class="primary" bindtap="continue">继续学习</button></view></view>

<view wx:for="{{flights}}" wx:key="id" class="flying-letter tile-tone-{{item.tone}}" style="{{item.style}}" animation="{{item.animation}}">{{item.letter}}</view>
