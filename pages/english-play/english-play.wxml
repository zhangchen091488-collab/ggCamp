<scene-background show="{{show}}"/>
<celebration show="{{show}}" mode="{{paused ? '' : 'burst'}}"/>
<view class="container paper english-play"><view class="progress">英语试用 · 第 {{number}} / {{total}} 题</view><view class="muted">{{packTitle}}</view><view class="english-growth">连击 {{combo}} · 欢乐值 {{dopa}}</view><show-stage show="{{show}}" quiet particles="{{false}}"/>
  <view class="card"><view class="card-heading"><view class="tag">{{phase === 'learn' ? '先认识它' : '看中文，写英文'}}</view><view wx:if="{{phase === 'answer'}}" class="answer-tools"><button class="symbol-button hint-button" bindtap="hint" aria-label="随机字母提示">?</button><button class="symbol-button" bindtap="skip" aria-label="不会，查看答案"><view class="eye-icon"><view class="eye-pupil"/></view></button></view></view><view class="prompt">{{prompt}}</view><view wx:if="{{phoneticUk || phoneticUs}}" class="phonetics"><text wx:if="{{phoneticUk}}">英音 {{phoneticUk}}</text><text wx:if="{{phoneticUs}}">美音 {{phoneticUs}}</text></view>
    <block wx:if="{{phase === 'learn'}}"><view class="canonical">{{canonical}}</view><view class="muted">读一读，记一记。当前词表尚未完成释义与单元审核。</view><button class="primary" bindtap="learned">我记住了，开始默写</button></block>
    <block wx:else><view class="answer-cells" aria-label="逐字母填写答案"><view wx:for="{{cells}}" wx:key="index" data-index="{{item.index}}" bindtap="selectCell" class="letter-cell {{item.space ? 'word-space' : ''}} {{item.active && phase === 'answer' ? 'active-cell' : ''}} {{!item.value && item.hint ? 'hint-cell' : ''}}"><text>{{item.value || item.hint}}</text></view></view><view class="feedback">{{feedback}}</view><view wx:if="{{phase === 'answer' && edits.length}}" class="differences"><text wx:for="{{edits}}" wx:key="id" class="edit-{{item.kind}}">{{item.display}}</text></view><view wx:if="{{hintText}}" class="muted">{{hintText}}</view><button wx:if="{{phase === 'feedback'}}" class="primary" bindtap="next">{{number === total ? '查看本轮成绩' : '下一题 →'}}</button></block>
  </view>
  <view wx:if="{{phase === 'answer'}}" class="keyboard">
    <view class="key-row"><button wx:for="{{shift ? upperRows[0] : rows[0]}}" wx:key="*this" data-key="{{item}}" bindtap="key">{{item}}</button></view>
    <view class="key-row"><button wx:for="{{shift ? upperRows[1] : rows[1]}}" wx:key="*this" data-key="{{item}}" bindtap="key">{{item}}</button></view>
    <view class="key-row"><button class="modifier-key {{shift ? 'shift-on' : ''}}" data-key="shift" bindtap="key" aria-label="切换大小写"><view class="shift-icon"><view class="shift-chevron"/><view class="shift-bar"/></view></button><button wx:for="{{shift ? upperRows[2] : rows[2]}}" wx:key="*this" data-key="{{item}}" bindtap="key">{{item}}</button><button class="modifier-key" data-key="backspace" bindtap="key" bindlongpress="clearAnswer" aria-label="删除，长按清空"><view class="backspace-icon"/></button></view>
    <view class="key-row punctuation-row"><button wx:for="{{punctuation}}" wx:key="*this" data-key="{{item}}" bindtap="key">{{item}}</button><button class="primary submit-key" bindtap="submit">提交</button></view>
  </view>
  <view wx:if="{{warning}}" class="warning">{{warning}}<button bindtap="retrySave">重试保存</button></view>
</view>
<view wx:if="{{paused}}" class="pause-shade" catchtouchmove="noop"><view class="card"><view class="prompt">准备好继续了吗？</view><view class="muted">答案与进度已经保留。</view><button class="primary" bindtap="continue">继续学习</button></view></view>
