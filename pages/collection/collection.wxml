<scene-background show="{{show}}"/>
<celebration show="{{show}}" mode="{{playing ? (cat === 'finale' ? 'finale' : cat === 'particle' ? 'burst' : '') : ''}}"/>
<view class="container paper collection"><view class="collection-head"><text class="heading">收藏</text><view class="head-right"><view class="owned">{{owned}}/{{total}}</view><button wx:if="{{debugAvailable}}" class="debug-btn {{debugOn ? 'on' : ''}}" bindtap="debugToggle">{{debugOn ? '调试中' : '调试'}}</button></view></view>
  <view wx:if="{{debugOn}}" class="debug-note">调试模式：全部收藏已解锁，仅影响本页预览，不写入奖杯和练习记录。再点一次「调试中」即可关闭。</view>
  <view class="preview-stage"><view class="preview-label">{{previewName}}{{auto ? ' · 随机搭配' : ''}}</view><show-stage show="{{show}}" preview-cat="{{cat}}" quiet particles="{{false}}"/></view>
  <view class="preview-controls"><button class="replay" bindtap="replay">{{musicPlaying ? '♫ 正在试听' : '↻ 再看一次'}}</button><button bindtap="toggle">{{playing ? '暂停效果' : '播放效果'}}</button><text>热闹程度 {{intensity}}%</text><slider class="energy" min="10" max="100" value="{{intensity}}" activeColor="#ed75a8" bindchange="intensity"/></view>
  <scroll-view scroll-x class="cat-scroll"><view class="cats"><button wx:for="{{cats}}" wx:key="key" class="{{cat === item.key ? 'current' : ''}}" data-cat="{{item.key}}" bindtap="tab">{{item.name}}<view>{{item.own}}/{{item.total}}</view></button></view></scroll-view><view class="note">{{auto ? '“随机搭配”会在每轮从已解锁的收藏中随机选择' : '每轮都使用你选中的收藏'}}</view>
  <view class="items"><button wx:for="{{rows}}" wx:key="id" class="item {{item.selected ? 'selected' : ''}} {{item.unlocked ? '' : 'locked'}}" data-id="{{item.id}}" bindtap="select" aria-label="{{item.unlocked ? item.name : item.description}}"><view class="thumb"><view wx:if="{{item.auto}}" class="random"><text class="random-mark">?</text></view><block wx:elif="{{item.thumb.buddies}}"><view wx:for="{{item.thumb.buddies}}" wx:for-item="buddy" wx:key="id" class="thumb-buddy"><image src="{{buddy.src}}" mode="aspectFit"/><image wx:if="{{buddy.wear}}" src="{{buddy.wear}}" mode="aspectFit"/></view></block><block wx:else><image wx:if="{{item.thumb.back}}" src="{{item.thumb.back}}" mode="aspectFit"/><image src="{{item.thumb.src}}" mode="aspectFit"/><image wx:if="{{item.thumb.wear}}" src="{{item.thumb.wear}}" mode="aspectFit"/></block></view><view class="item-name">{{item.unlocked ? item.name : '？？？'}}</view><view class="description">{{item.description || '　'}}</view></button></view>
</view>
