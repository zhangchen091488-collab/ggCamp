.collection-head { display:flex;align-items:center;justify-content:space-between; }.heading {font-size:36rpx;}.head-right {display:flex;align-items:center;gap:12rpx;}.owned {font-family:Chunky,sans-serif;font-size:28rpx;border:4rpx solid #20234f;border-radius:50rpx;padding:7rpx 17rpx;background:#fff;}
.debug-btn {font-size:20rpx;font-weight:700;line-height:1.2;padding:8rpx 14rpx;border-width:3rpx;border-radius:18rpx;box-shadow:0 4rpx 0 #20234f;background:#ffffffed;color:#565a79;}
.debug-btn.on {background:#b6354b;color:#fff9ee;}
.debug-note {margin-top:14rpx;padding:14rpx 18rpx;border-radius:18rpx;background:#fff0ab;color:#6b4a00;font-size:21rpx;line-height:1.5;}.preview-stage {margin-top:16rpx;position:relative;border:5rpx solid #20234f;border-radius:38rpx;overflow:hidden;background:transparent;}.preview-label {position:relative;display:inline-block;margin:12rpx 14rpx 0;font-size:19rpx;padding:4rpx 12rpx;border-radius:30rpx;background:#20234f;color:#fff9ee;z-index:5;}.preview-controls {display:flex;flex-wrap:wrap;align-items:center;gap:12rpx;margin:20rpx 0 12rpx;}.preview-controls button {padding:10rpx 15rpx;font-size:22rpx;flex:1;}.preview-controls .replay {background:#fff3c4;}.preview-controls text {font-size:21rpx;}.energy {width:100%;margin:0;}.cat-scroll {width:100%;margin-top:8rpx;}.cats {display:flex;gap:7rpx;padding:8rpx 0 12rpx;}.cats button {flex-shrink:0;white-space:nowrap;font-size:21rpx;padding:8rpx 13rpx;border-radius:21rpx;background:#fff;}.cats button view {font-size:17rpx;font-family:Chunky,sans-serif;}.cats .current {background:#ffd23f;box-shadow:0 4rpx #20234f;}.note {font-size:20rpx;color:#565a79;text-align:center;margin:8rpx 0 18rpx;}.items {display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;}.item {position:relative;padding:12rpx 6rpx;border-radius:25rpx;background:#fff;min-width:0;}.item.selected {background:#fff3c4;border-color:#ed75a8;box-shadow:0 5rpx #20234f;}.thumb {height:110rpx;display:flex;align-items:center;justify-content:center;position:relative;margin:4rpx 0 8rpx;}.thumb>image {position:absolute;width:100%;height:100%;left:0;top:0;}.thumb-buddy {position:relative;width:33%;height:100%;}.thumb-buddy image {position:absolute;inset:0;width:100%;height:100%;}.random {width:80rpx;height:80rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;line-height:1;border:4rpx dashed #20234f;border-radius:50%;font-family:Chunky,sans-serif;font-size:46rpx;color:#ed75a8;}.item-name {font-size:22rpx;font-weight:900;}.description {font-size:16rpx;line-height:1.4;font-weight:400;color:#787c98;margin-top:5rpx;}.locked {background:#ecebf2;color:#a1a2b3;}.locked .thumb {filter:grayscale(1);opacity:.35;}

.collection.paper { position:relative;z-index:1;background-image:none; }

.collection-head .heading {background:#ffffffed;border-radius:24rpx;padding:5rpx 16rpx;}
.preview-controls text,.note {background:#ffffffed;border-radius:18rpx;padding:6rpx 12rpx;}

.random-mark {display:block;width:100%;text-align:center;line-height:1;font-family:Chunky,sans-serif;}
