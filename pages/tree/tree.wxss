 .tree-page .heading { font-size: 42rpx; } .filters { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 20rpx 0; } .filters button { font-size: 24rpx; padding: 10rpx 16rpx; } .graph-scroll { height: 66vh; margin-top: 20rpx; border: 2rpx solid #20234f22; } .graph { position: relative; } .lane { position: absolute; top: 0; text-align: center; background: #20234f; color: #fff9ee; font-size: 12px; line-height: 26px; box-sizing: border-box; border: 2px solid #fff9ee; } .link { position: absolute; } .node { position: absolute; width: 74px; height: 70px; padding: 5px; font-size: 11px; border-width: 2px; border-radius: 12px; line-height: 1.25; } .node.locked { background: #e9e9f0; color: #85899e; } .node.new { background: #fff0ab; } .node.learning { background: #e4e8ff; } .node.mastered { background: #ffd76a; } .grade { font-size: 9px; margin-bottom: 3px; } .stars { font-size: 10px; color: #b48212; } .skill-info { margin-top: 20rpx; padding: 24rpx; border: 4rpx solid #20234f; border-radius: 24rpx; background: #fffdf7; } .skill-info button { margin-top: 18rpx; }