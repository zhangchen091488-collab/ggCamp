<view class="container paper tree-page"><view class="heading">技能树</view><view class="muted">已掌握 {{mastered}}/58 · ★ {{stars}}/290</view><view class="filters"><button wx:for="{{grades}}" wx:key="*this" class="{{filter === item ? 'secondary' : ''}}" data-grade="{{item}}" bindtap="filter">{{item ? item + '年级' : '全部'}}</button></view><view class="muted">左右滑动查看类别，点击技能查看条件，长按可重置</view><scroll-view class="graph-scroll" scroll-x scroll-y enhanced><view class="graph" style="{{graphStyle}}"><view wx:for="{{lanes}}" wx:key="name" class="lane" style="{{item.style}}">{{item.name}}</view><view wx:for="{{links}}" wx:key="id" class="link" style="{{item.style}}"></view><button wx:for="{{skills}}" wx:key="id" class="node {{item.state}}" style="{{item.style}}" data-id="{{item.id}}" bindtap="inspect" bindlongpress="reset"><view class="grade">{{item.grade}}年级 {{item.state === 'locked' ? '🔒' : ''}}</view><view>{{item.name}}</view><view class="stars">{{item.stars}}</view></button></view></scroll-view><view wx:if="{{selected}}" class="skill-info"><view class="heading">{{selected.name}}</view><view>★ {{selected.stars}} / 5</view><view class="muted">{{selected.rule}}</view><view class="muted">{{selected.now}}</view><view wx:if="{{!selected.unlocked}}" class="muted">先掌握：{{selected.reqNames}}</view><button class="primary" disabled="{{!selected.unlocked}}" bindtap="start">开始专项练习</button><button bindtap="close">收起</button></view></view>