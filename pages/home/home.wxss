.home { position: relative; }.top-actions { position: absolute; right: 22rpx; top: 22rpx; display: flex; flex-direction: column; gap: 20rpx; z-index: 3; }.icon-button { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; padding: 7rpx; border-radius: 50%; background: #fff; box-shadow: 0 6rpx #20234f; }.icon-button image { width: 100%; height: 100%; transition: transform .4s; }.icon-button.pressed { transform: translateY(4rpx); box-shadow: 0 2rpx #20234f; }.gear.pressed image { transform: rotate(90deg); }.help-icon.pressed image { transform: rotate(-12deg); }
.logo { text-align: center; margin: 110rpx 0 12rpx; pointer-events: none; }.guagua-word { display: flex; justify-content: center; font-size: 92rpx; line-height: 1.2; font-weight: 900; letter-spacing: -5rpx; text-shadow: 3rpx 3rpx #20234f,-2rpx -2rpx #20234f,2rpx -2rpx #20234f,-2rpx 2rpx #20234f; }.c1 { color:#ffc84b; }.c2 { color:#9ce377; }.c3 { color:#59baff; }.c4 { color:#ed88b4; }.c5 { color:#77daca; }.guagua-word text:nth-child(odd) { transform: rotate(-4deg); }.guagua-word text:nth-child(even) { transform: rotate(3deg); }.guagua-underline { width: 35%; height: 8rpx; margin: 15rpx auto 0; background: #69cbb5; border-radius: 50%; transform: rotate(-3deg); }.moving .guagua-word text { animation: letter-wave 4s ease-in-out infinite; }.moving .guagua-word text:nth-child(2) { animation-delay: -.4s; }.moving .guagua-word text:nth-child(3) { animation-delay: -.8s; }.moving .guagua-word text:nth-child(4) { animation-delay: -1.2s; }.moving .guagua-word text:nth-child(5) { animation-delay: -1.6s; }@keyframes letter-wave { 50% { transform: translateY(-5rpx) rotate(-3deg); } }
.modes { max-width: 590rpx; margin: 12rpx auto 0; }.level { width: 75%; margin: 12rpx auto 26rpx; font-size: 38rpx; }.button-note { font-size: 23rpx; margin-top: 6rpx; font-weight: 500; }.review { width: 75%; margin: 0 auto 24rpx; background: #fff3c4; }.resume { margin-bottom: 24rpx; font-size: 25rpx; }.counter { font-family: Chunky,sans-serif; font-size: 29rpx; color: #ed75a8; text-shadow: 1rpx 1rpx #20234f; font-style: italic; }
.grades { display: flex; flex-wrap: wrap; gap: 12rpx; }.grade { width: calc((100% - 24rpx) / 3); display: flex; align-items: baseline; justify-content: center; gap: 3rpx; padding: 9rpx 6rpx; font-size: 24rpx; border-radius: 23rpx; box-shadow: 0 5rpx #20234f; }.grade-number { font-family: Chunky,sans-serif; font-size: 45rpx; font-weight: 900; }.grade-1 { background:#ffe1ee; }.grade-2 { background:#e4e8ff; }.grade-3 { background:#fff3c4; }.grade-4 { background:#d9fff1; }.grade-5 { background:#f3e7ff; }.grade-6 { background:#ffead4; }
.nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 15rpx; margin-top: 23rpx; }.nav button { padding: 12rpx 16rpx; font-size: 24rpx; border-radius: 24rpx; box-shadow: 0 5rpx #20234f; }.home-card { max-width: 710rpx; margin: 26rpx auto 0; }.calendar-wrap { margin-top: 28rpx; }.calendar-detail { display: block; background: transparent; padding: 18rpx 0 0; border: 0; font-size: 23rpx; color:#565a79; }.footnote { color:#696d86; font-size: 21rpx; margin-top: 25rpx; text-align: center; }
.reward-shade { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; background: #101637b8; padding: 30rpx; }.reward-dialog { width: 100%; max-width: 660rpx; padding: 30rpx; box-sizing: border-box; border: 5rpx solid #20234f; border-radius: 38rpx; background: #fff9ee; box-shadow: 0 10rpx #20234f; }.section-title { font-size: 35rpx; font-weight: 900; margin: 8rpx 0 22rpx; }.reward-dialog button { margin-top: 20rpx; }.reward-art { display: block; margin: auto; width: 130rpx; height: 130rpx; transform: rotate(-20deg); }.reward-list { max-height: 50vh; }.reward { padding: 20rpx 0; border-bottom: 2rpx dashed #20234f33; font-size: 25rpx; }.bonus-slots { display: flex; gap: 6rpx; margin: 22rpx 0; }.bonus-slot { flex: 1; min-width: 0; padding: 12rpx 0; text-align: center; background: #fff; border: 3rpx solid #20234f; border-radius: 12rpx; font-size: 17rpx; }.bonus-slot.got { background:#fff3c4; }.bonus-slot.today { border-color:#ed75a8; }.bonus-slot image { display: block; width: 52rpx; height: 52rpx; margin: 12rpx auto 0; }.unknown { display: block; font-family: Chunky,sans-serif; font-size: 38rpx; opacity: .3; }
.guide-overlay { position: fixed; inset: 0; z-index: 99; }.guide-shade { position: absolute; inset:0; background:#101637c2; }.guide-hole { position: fixed; box-sizing: border-box; border: 5rpx solid #ffd23f; border-radius: 28rpx; box-shadow: 0 0 0 3000rpx #101637c2; }.guide-actor { position: fixed; z-index: 2; }.guide-moving { animation: guide-bob 2s ease-in-out infinite; }@keyframes guide-bob { 50% { transform: translateY(-6rpx); } }.guide-skip { position: absolute; top: 18rpx; right: 20rpx; padding: 12rpx 22rpx; font-size: 24rpx; z-index: 5; background:#fff9ee; }.guide-card { text-align:center; position: fixed; box-sizing: border-box; z-index: 4; padding: 26rpx; background:#fff9ee; border:5rpx solid #20234f; border-radius: 32rpx; box-shadow:0 9rpx #20234f; }.guide-title { font-size: 34rpx; font-weight: 900; }.guide-text { font-size: 27rpx; line-height: 1.55; margin-top: 12rpx; white-space: pre-line; }.inline-help { width: 40rpx; height: 40rpx; vertical-align: middle; margin-left: 10rpx; }.guide-dots { display: flex; justify-content: center; gap: 12rpx; margin: 22rpx 0; }.guide-dots view { width: 14rpx; height: 14rpx; border:3rpx solid #20234f; background:#fff; border-radius:50%; }.guide-dots .current { background:#ed75a8; transform:scale(1.2); }.guide-actions { display: flex; gap: 18rpx; }.guide-actions button { flex: 1; padding: 15rpx 12rpx; font-size: 28rpx; }.recommend { position:absolute; top:-34rpx; left:4rpx; background:#ffd23f; color:#20234f; padding:4rpx 16rpx; border:3rpx solid #20234f; border-radius: 12rpx; font-size: 21rpx; font-weight:900; transform:rotate(-7deg); }

.guide-actions .primary { background:#3b6bff; color:#fff; }



.subject-switch {width:80rpx;min-height:66rpx;padding:9rpx 0;font-size:24rpx;border-radius:22rpx;background:#fff0ab;line-height:1.3;}.subject-switch text {display:block;font-size:20rpx;}.english-choice {width:calc((100% - 12rpx) / 2);font-size:30rpx;padding:18rpx;}.selected-kind {background:#fff0ab;border-color:#4169ff;}

.english-options { margin-top:20rpx;display:flex;flex-direction:column;gap:16rpx; }.english-option-row {display:flex;gap:12rpx;}.english-option-row button {flex:1;font-size:26rpx;padding:12rpx;border-radius:23rpx;box-shadow:0 5rpx #20234f;}

.home-action-row {display:flex;align-items:stretch;gap:12rpx;height:144rpx;margin-bottom:24rpx;}
.home-action-side {flex:0 0 88rpx;min-width:0;display:flex;align-items:stretch;}
.home-action-row .level {flex:1;min-width:0;width:auto;height:144rpx;box-sizing:border-box;margin:0;padding:8rpx 10rpx;font-size:29rpx;display:flex;flex-direction:column;justify-content:center;}
.home-action-row .button-note {font-size:18rpx;line-height:1.4;margin-top:6rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.home-action-side .resume,.home-action-side .review {width:100%;height:144rpx;margin:0;padding:8rpx 4rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:25rpx;line-height:1.4;border-radius:22rpx;box-sizing:border-box;}
.home-action-side .counter {display:block;font-size:27rpx;}
