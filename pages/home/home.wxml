<view class="container paper home {{motion > 0 ? 'moving' : ''}}">
  <view class="top-actions"><button class="icon-button gear" data-page="settings" bindtap="go" hover-class="pressed" aria-label="设置"><image src="/assets/ui/settings.png"/></button><button class="icon-button help-icon" bindtap="help" hover-class="pressed" aria-label="玩法说明"><image src="/assets/ui/guide.png"/></button><button class="subject-switch" bindtap="switchSubject" aria-label="切换数学或英语">{{subject === 'english' ? '英语' : '数学'}}<text>⇄</text></button></view>
  <view class="logo"><view class="guagua-word"><text class="c1">瓜</text><text class="c2">瓜</text><text class="c3">训</text><text class="c4">练</text><text class="c5">营</text></view><view class="guagua-underline"></view></view>
  <show-stage wx:if="{{!guideOpen}}" show="{{show}}" quiet/><view wx:else style="height:320rpx"></view>
  <view class="modes"><view class="home-action-row">
    <view class="home-action-side"><button wx:if="{{resume}}" class="resume secondary" bindtap="resume" aria-label="{{subject === 'english' ? '继续：' + resumeBookTitle : '继续未完成的练习'}}">继续</button></view>
    <button id="tour-level" class="primary level" data-mode="level" bindtap="start">{{subject === 'english' ? '今日英语练习' : '适合我的题'}}<view class="button-note">{{subject === 'english' ? englishBookTitle : placed ? '从适合你的下一步开始' : '先做一次能力测评'}}</view></button>
    <view class="home-action-side"><button wx:if="{{review}}" class="review" data-mode="review" bindtap="start">复习 <text class="counter">{{review}}</text></button></view>
  </view>
  <view id="tour-grades" class="grades"><block wx:if="{{subject === 'english'}}"><button wx:for="{{englishGrades}}" wx:key="*this" class="grade grade-{{item}} {{englishGrade === item ? 'selected-kind' : ''}}" data-grade="{{item}}" bindtap="englishGrade"><text class="grade-number">{{item}}</text><text>年级</text></button></block><block wx:else><button wx:for="{{grades}}" wx:key="*this" class="grade grade-{{item}}" data-grade="{{item}}" data-mode="grade" bindtap="start"><text class="grade-number">{{item}}</text><text>年级</text></button></block></view>
  <view wx:if="{{subject === 'english'}}" class="english-options"><view class="english-option-row"><button wx:for="{{englishSemesters}}" wx:key="*this" class="{{englishSemester === item ? 'selected-kind' : ''}}" data-semester="{{item}}" bindtap="englishSemester">{{item === 'first' ? '上册' : '下册'}}</button></view><view class="english-option-row"><button class="{{englishKind === 'word' ? 'selected-kind' : ''}}" data-kind="word" bindtap="englishKind">单词</button><button class="{{englishKind === 'phrase' ? 'selected-kind' : ''}}" data-kind="phrase" bindtap="englishKind">常用语</button></view></view>
  <view class="nav"><button id="tour-tree" data-page="tree" bindtap="go">{{subject === 'english' ? '学习进度' : '技能树'}} <text class="counter">{{mastered}}/{{learningTotal}}</text></button><button id="tour-trophy" data-page="trophy" bindtap="go">奖杯 <text class="counter">{{trophyCount}}/{{trophyTotal}}</text></button><button id="tour-collection" data-page="collection" bindtap="go">收藏 <text class="counter">{{collectionCount}}/{{collectionTotal}}</text></button></view></view>
  <view class="home-card"><quest-list rows="{{quests}}"/></view>
  <view class="home-card calendar-wrap"><practice-calendar refresh="{{calendarRefresh}}"/></view><button class="calendar-detail" data-page="calendar" bindtap="go">查看签到卡与练习记录 →</button>
  <view wx:if="{{warning}}" class="warning">{{warning}}</view><view class="footnote">和瓜瓜伙伴一起，每天进步一点点</view>
</view>
<view wx:if="{{hammerOffer && !guideOpen}}" class="reward-shade" catchtouchmove="noop"><view class="reward-dialog"><image class="reward-art" src="/assets/ui/hammer.png"/><view class="section-title">补签锤帮你延续记录</view><view class="muted">补上 {{hammerOffer.days.length}} 个空白日，保留 {{hammerOffer.run}} 天的连续记录。</view><button class="secondary" bindtap="useHammer">使用补签锤（持有 {{held}} 把）</button><button bindtap="declineHammer">这次不用</button></view></view>
<view wx:if="{{bonus && !hammerOffer && !guideOpen}}" class="reward-shade" catchtouchmove="noop"><view class="reward-dialog"><view class="section-title">签到贴纸，第 {{bonus.slot}} 天！</view><view class="bonus-slots"><view wx:for="{{bonusSlots}}" wx:key="day" class="bonus-slot {{item.got ? 'got' : ''}} {{item.today ? 'today' : ''}}"><text>第 {{item.day}} 天</text><image wx:if="{{item.got}}" src="{{item.image}}"/><text wx:else class="unknown">{{item.day === 7 ? '？' : item.day}}</text></view></view><view class="muted">{{bonus.slot === 7 ? '获得特别贴纸！已贴在日历上' : '再签到 ' + (7 - bonus.slot) + ' 天就能获得特别贴纸'}}</view><button class="primary" bindtap="bonusClose">收好啦</button></view></view>
<view wx:if="{{fresh.length && !bonus && !hammerOffer && !guideOpen}}" class="reward-shade" catchtouchmove="noop"><view class="reward-dialog"><view class="section-title">获得奖杯！</view><scroll-view scroll-y class="reward-list"><view wx:for="{{fresh}}" wx:key="id" class="reward"><text>🏆 {{item.name}}</text><view class="muted">{{item.desc}}</view><view wx:if="{{item.reward}}">收藏「{{item.reward}}」已解锁！</view></view></scroll-view><button class="primary" bindtap="freshClose">太棒啦！</button></view></view>
<view wx:if="{{guideOpen}}" class="guide-overlay" catchtouchmove="noop" catchtap="noop" aria-role="dialog" aria-label="玩法说明">
  <view wx:if="{{!guideTarget || !holeStyle}}" class="guide-shade"></view><view wx:else class="guide-hole" style="{{holeStyle}}"><text wx:if="{{guideLast}}" class="recommend">推荐</text></view>
  <image class="guide-actor {{motion > 0 ? 'guide-moving' : ''}}" style="{{actorStyle}}" src="{{guideActor}}" mode="aspectFit"/>
  <button class="guide-skip" bindtap="guideClose">跳过</button>
  <view class="guide-card" style="{{cardStyle}}"><view class="guide-title">{{guideTitle}}</view><view class="guide-text">{{guideText}}<image wx:if="{{guideLast}}" class="inline-help" src="/assets/ui/guide.png"/></view><view class="guide-dots" aria-label="第 {{guideIndex + 1}} 步，共 {{guideDots.length}} 步"><view wx:for="{{guideDots}}" wx:key="*this" class="{{item === guideIndex ? 'current' : ''}}"></view></view><view class="guide-actions"><button bindtap="guideBack" disabled="{{guideIndex === 0}}">返回</button><button class="primary" bindtap="guideNext">{{guideLast ? '开始吧！' : '下一步'}}</button></view></view>
</view>
