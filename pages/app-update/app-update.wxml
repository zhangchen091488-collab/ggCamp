<view class="container paper"><view class="heading">应用更新</view><view class="section"><view class="label">当前版本 {{version}}</view><view class="setting-row"><text>接收测试版</text><switch checked="{{beta}}" disabled="{{busy}}" color="#ed75a8" bindchange="beta"/></view><view wx:if="{{beta}}" class="muted">测试版可能不够稳定，关闭后仍会检查正式版。</view></view><view class="section"><view class="update-status">{{status}}</view><view wx:if="{{candidate}}"><view class="label">{{candidate.versionName}} · {{size}} MB</view><view class="release-notes">{{candidate.releaseNotes}}</view></view></view><view class="section stack"><button class="secondary" wx:if="{{candidate}}" disabled="{{busy}}" bindtap="install">下载并安装</button><button disabled="{{busy}}" bindtap="check">检查更新</button><button wx:if="{{busy}}" bindtap="cancel">取消</button><button disabled="{{busy}}" bindtap="copy">复制发布页地址</button></view></view>
