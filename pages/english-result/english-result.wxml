<scene-background show="{{show}}"/><celebration wx:if="{{celebrating}}" show="{{show}}" mode="finale" label="英语练习完成" bindcomplete="celebrationComplete"/>
<view wx:if="{{celebrating}}" class="celebration-controls"><view>这一轮完成啦！</view><button bindtap="celebrationComplete">查看成绩 →</button></view>
<view wx:if="{{!celebrating}}" class="container paper result"><show-stage show="{{show}}" quiet particles="{{false}}"/><view class="badge">✓ 英语试用练习完成</view><view class="heading">又记住了一点点！</view><view class="score"><text>{{firstRate}}</text>% 独立答对</view>
<view class="stats"><view>完成题目<text>{{count}} 题</text></view><view>首次独立答对<text>{{first}} 题</text></view><view>再试次数<text>{{retries}} 次</text></view><view>看答案后完成<text>{{skipped}} 题</text></view><view>获得题目奖励<text>{{rewarded || 0}} 题</text></view><view>欢乐值<text>{{dopa}}</text></view><view>学习用时<text>{{time}}</text></view></view>
<view wx:if="{{wrong.length}}" class="heading">下次再巩固</view><view wx:for="{{wrong}}" wx:key="itemId" class="news">{{item.promptZh}} · {{item.canonical}}</view><view wx:for="{{fresh}}" wx:key="id" class="news">新奖杯：{{item.name}} {{item.reward}}</view><view wx:if="{{!recorded}}" class="muted">本轮没有新增独立题目奖励，不重复计入完成任务和签到。</view><view class="muted">{{packTitle}} · 奖励与每日任务两科共享，英语掌握进度独立。同一内容、同一题型当天只奖励一次。</view><view wx:if="{{warning}}" class="warning">{{warning}}<button bindtap="retrySave">重试保存</button></view><view class="stack"><button class="primary" bindtap="home">返回英语学习营</button></view></view>
