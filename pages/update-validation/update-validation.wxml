<view class="container paper"><view class="heading">应用更新验证</view><view class="section"><view>当前版本 {{version}}</view><view>宿主版本 {{hostVersion}}</view><view>安装接口：{{installAvailable ? '可用' : '不可用'}}</view></view><view class="section stack"><button bindtap="record" disabled="{{busy}}">记录升级前存档</button><button bindtap="check" disabled="{{busy}}">检查验证更新</button><button wx:if="{{candidate}}" bindtap="install" disabled="{{busy}}">下载并安装 {{candidate.versionName}}</button><button wx:if="{{busy}}" bindtap="cancel">取消</button></view><view class="section">{{status}}</view><view class="muted">仅用于 USB 连接的更新验证，不连接正式更新渠道。</view></view>
