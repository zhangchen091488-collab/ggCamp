<view class="container paper tree-page book-page">
  <view class="heading">技能树</view>
  <view class="book-title">{{title}}</view>
  <view class="muted">学校已学 {{learnedCount}}/{{units.length}} 单元 · 已掌握 {{overview.mastered}}/{{overview.total}}</view>
  <view class="kind-row"><button class="{{kind === 'word' ? 'secondary' : ''}}" data-kind="word" bindtap="chooseKind">单词</button><button class="{{kind === 'phrase' ? 'secondary' : ''}}" data-kind="phrase" bindtap="chooseKind">常用语</button></view>
  <view class="book-tools"><button bindtap="openScope">学校学到哪里</button><button bindtap="openCombo">组合练习</button></view>
  <view class="muted route-hint">沿路线查看单元，点击节点开始专项练习</view>
  <scroll-view class="graph-scroll" scroll-x scroll-y enhanced>
    <view class="graph" style="{{graphStyle}}">
      <view class="lane unit-lane">教材单元</view>
      <view wx:for="{{links}}" wx:key="id" class="link" style="{{item.style}}"></view>
      <button wx:for="{{units}}" wx:key="unitId" class="node {{item.state}} {{selected && selected.unitId === item.unitId ? 'active' : ''}}" style="{{item.style}}" data-id="{{item.unitId}}" bindtap="inspect">
        <view class="grade">Unit {{index + 1}}{{item.learned ? ' · 已学' : ''}}</view>
        <view class="node-title">{{item.nodeTitle}}</view>
        <view class="node-progress">{{item.total ? item.mastered + '/' + item.total : '暂无内容'}}</view>
      </button>
    </view>
  </scroll-view>
  <view class="muted content-note">连线表示教材顺序，所有单元都可自由练习。当前使用中文提示默写。</view>
</view>
<view wx:if="{{panel}}" class="panel-mask">
  <view class="book-panel skill-info">
    <view class="panel-header"><view class="heading">{{panel === 'scope' ? '学校学到哪里' : panel === 'combo' ? '组合练习' : selected.title}}</view><button class="close-button" bindtap="closePanel">关闭</button></view>
    <scroll-view scroll-y class="panel-body">
      <block wx:if="{{panel === 'detail'}}">
        <view class="muted">{{selected.contentWords}} 个单词 · {{selected.contentPhrases}} 条常用语</view>
        <view class="detail-progress">{{kind === 'word' ? '单词' : '常用语'}}掌握 {{selected.mastered}}/{{selected.total}}</view>
        <view class="muted">待巩固 {{selected.needsReview}} · 到期复习 {{selected.due}}</view>
        <view class="muted mastery-note">同一词条在三个不同日期首次独立答对，即可掌握。</view>
        <button class="primary" disabled="{{!selected.total}}" data-id="{{selected.unitId}}" bindtap="start">开始专项练习</button>
        <view wx:if="{{!selected.total}}" class="muted">本单元暂无{{kind === 'word' ? '单词' : '常用语'}}，可回到路线切换类别。</view>
        <view class="unit-actions"><button bindtap="openContent">词表与学习卡</button><button data-id="{{selected.unitId}}" data-mode="review" bindtap="start">单元错题</button></view>
      </block>
      <block wx:elif="{{panel === 'content'}}">
        <button bindtap="backDetail">返回单元详情</button>
        <view wx:if="{{!items.length}}" class="muted">本单元暂无所选内容。</view>
        <view wx:if="{{card}}" class="study-card"><view class="muted">学习卡</view><view class="card-english">{{card.canonical}}</view><view>{{card.promptZh}}</view><view wx:if="{{card.phoneticUk}}" class="muted">英 {{card.phoneticUk}}</view><view wx:if="{{card.phoneticUs}}" class="muted">美 {{card.phoneticUs}}</view><view class="unit-actions"><button class="primary" bindtap="nextCard">下一张</button><button bindtap="closeCard">收起</button></view></view>
        <view class="word-list"><button wx:for="{{items}}" wx:for-item="entry" wx:key="itemId" class="word-row" data-index="{{index}}" bindtap="study"><text class="english">{{entry.canonical}}</text><text class="meaning">{{entry.promptZh}}</text></button></view>
        <view class="muted content-note">点击词条查看学习卡。朗读与听音默写尚未提供。</view>
      </block>
      <block wx:else>
        <view class="muted panel-note">{{panel === 'scope' ? '勾选学校已经教过的单元，今日练习从这些单元出题。标记不代表掌握。' : '选择本次想练的单元，不会改变学校已学范围。'}}</view>
        <button wx:for="{{units}}" wx:key="unitId" class="selection-row {{(panel === 'scope' ? item.learned : item.selected) ? 'secondary' : ''}}" data-id="{{item.unitId}}" bindtap="{{panel === 'scope' ? 'toggleLearned' : 'togglePractice'}}"><text>{{(panel === 'scope' ? item.learned : item.selected) ? '✓' : '○'}} {{item.title}}</text></button>
        <view wx:if="{{panel === 'scope'}}" class="muted">已选 {{learnedCount}} 个单元，修改自动保存。</view>
        <view wx:else class="multi-actions"><view>已选 {{selectedCount}} 个单元</view><button class="primary" disabled="{{!selectedCount}}" bindtap="start">开始组合练习</button><button disabled="{{!selectedCount}}" data-mode="review" bindtap="start">复习所选错题</button></view>
      </block>
    </scroll-view>
  </view>
</view>
