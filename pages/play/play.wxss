.play.paper {position:relative;z-index:1;background-image:none;padding:24rpx 30rpx 36rpx;padding-bottom:calc(36rpx + env(safe-area-inset-bottom));}
.hud {position:relative;}.hud-top,.hud-bottom {display:flex;justify-content:space-between;align-items:center;gap:12rpx;}.hud-bottom {margin-top:14rpx;align-items:flex-start;}.progress {display:flex;flex-wrap:wrap;gap:7rpx;max-width:48%;}.pip {width:17rpx;height:17rpx;border:4rpx solid #20234f;border-radius:50%;background:#fff;}.pip.current {background:#ffd23f;}.pip.done {background:#3fdcb0;}.time-controls {display:flex;gap:10rpx;align-items:center;}.timer {display:flex;gap:12rpx;align-items:baseline;border:5rpx solid #20234f;border-radius:60rpx;background:#fff;padding:8rpx 18rpx;font-size:21rpx;font-weight:800;}.timer-value {font-family:Chunky,sans-serif;font-size:34rpx;font-weight:900;}.sound {width:62rpx;height:62rpx;border-radius:50%;padding:0;display:flex;align-items:center;justify-content:center;font-size:36rpx;line-height:1;}.tallies {display:flex;gap:10rpx;}.tally {border:4rpx solid #20234f;border-radius:40rpx;background:#fff;padding:8rpx 13rpx;font-size:21rpx;font-weight:800;white-space:nowrap;}.tally text {font-family:Chunky,sans-serif;font-size:30rpx;}.tally .total {font-family:inherit;font-size:18rpx;color:#787c98;}.wrong text {color:#a77bff;}.dopa {background:#ffd23f;border:5rpx solid #20234f;border-radius:25rpx;box-shadow:0 8rpx #20234f;padding:9rpx 14rpx;font-size:21rpx;font-weight:800;display:flex;gap:10rpx;align-items:baseline;}.dopa text {font-family:Chunky,sans-serif;font-size:36rpx;}.combo {position:absolute;top:100%;left:0;background:#fff;border:3rpx solid #20234f;border-radius:16rpx;padding:5rpx 12rpx;font-size:22rpx;color:#c9447d;z-index:2;}
.actor-stage {position:relative;margin-top:16rpx;height:190rpx;}.ground {position:absolute;left:6%;right:6%;bottom:6rpx;height:12rpx;border-top:4rpx solid #20234f;border-radius:50%;pointer-events:none;}.problem {position:relative;padding:20rpx 20rpx 22rpx;background:#fff;border:5rpx solid #20234f;border-radius:42rpx;box-shadow:0 12rpx #20234f;margin-bottom:18rpx;}.problem-head {display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:23rpx;font-weight:900;}.skill-badge {background:#3b6bff;color:#fff;border-radius:40rpx;padding:6rpx 20rpx;font-size:25rpx;max-width:75%;}.label {font-size:26rpx;font-weight:800;text-align:center;color:#3b6bff;}.hint {margin-top:12rpx;font-size:23rpx;line-height:1.5;color:#565a79;text-align:center;padding-right:42rpx;}.hint-toggle {position:absolute;right:18rpx;bottom:16rpx;width:38rpx;height:38rpx;display:flex;align-items:center;justify-content:center;padding:0;border:3rpx solid #3b6bff;border-radius:50%;color:#3b6bff;font-size:23rpx;line-height:1;box-shadow:none;}.feedback {margin:14rpx 0;font-size:23rpx;text-align:center;font-weight:800;background:#ffffffed;padding:8rpx;border-radius:20rpx;color:#20234f;}.pad {display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;}.pad button {width:100%;padding:12rpx 6rpx;height:84rpx;min-height:44px;font-family:Chunky,sans-serif;font-size:42rpx;border:5rpx solid #20234f;border-radius:28rpx;line-height:1.2;box-shadow:0 9rpx #20234f;background:#fff;}.pad .erase {background:#ffd2e6;}.pad .zero {grid-column:span 2;}.pad button:active {transform:translateY(5rpx);box-shadow:0 3rpx #20234f;}.pause {padding:24rpx;border-radius:24rpx;background:#fff;}.pause .heading {font-size:36rpx;}.pause button {margin-top:24rpx;}.next {margin-top:26rpx;}.celebrate {animation:pop .3s ease-out;color:#b2376f;}@keyframes pop {50% {transform:scale(1.04);}}.capsule,.demo {padding:12rpx;background:#ffe3b8;margin-bottom:12rpx;border-radius:14rpx;font-size:22rpx;}.hurry .timer {color:#b6354b;}

.hint-toggle {box-sizing:border-box;}.hint-icon {display:block;flex:none;width:28rpx;height:28rpx;}
