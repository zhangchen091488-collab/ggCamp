<view class="container paper"><view class="heading">设置</view><view class="section"><view class="label">训练营伙伴</view><view class="partner-preview"><show-stage show="{{show}}" preview-cat="character" quiet particles="{{false}}"/><view class="partner-name">{{characterName}}</view></view><view class="counts"><button class="{{character === 'girl' ? 'secondary' : ''}}" data-character="girl" bindtap="character">瓜瓜</button><button class="{{character === 'boy' ? 'secondary' : ''}}" data-character="boy" bindtap="character">年年</button></view></view><view class="section"><view class="label">英语教材版本</view><view class="stack"><button wx:for="{{englishVersions}}" wx:key="id" class="{{englishBookIndex === index ? 'secondary' : ''}}" data-index="{{index}}" bindtap="englishBook">{{item.title}}{{englishBookIndex === index ? ' ✓' : ''}}</button></view></view><view class="section"><view class="label">英语答题方式</view><view class="counts"><button class="{{englishInputMethod === 'cards' ? 'secondary' : ''}}" data-method="cards" bindtap="englishInput">字母卡答题</button><button class="{{englishInputMethod === 'keyboard' ? 'secondary' : ''}}" data-method="keyboard" bindtap="englishInput">键盘答题</button></view></view><view class="section"><view class="label">题目数量</view><view class="counts"><button wx:for="{{counts}}" wx:key="*this" class="{{count === item ? 'secondary' : ''}}" data-count="{{item}}" bindtap="count">{{item}}题</button></view></view><view class="section"><view class="setting-row"><text>声音</text><switch checked="{{sound}}" color="#ed75a8" bindchange="sound"/></view><view class="label">音量 {{volumePercent}}%</view><slider min="0" max="100" value="{{volumePercent}}" activeColor="#ed75a8" bindchange="volume"/></view><view class="section"><view class="label">动画强度 {{motion}}%</view><slider min="0" max="100" value="{{motion}}" activeColor="#ed75a8" bindchange="motion"/><view class="muted">调为 0% 可停止晃动、闪光、彩纸和移动动画</view></view><view class="section stack"><button class="secondary" bindtap="demo">▶ 看一段自动演示</button><button bindtap="guide">逐步查看玩法说明</button></view><view class="section"><view class="label">本地数据</view><view class="muted">记录保存在当前微信设备，暂不与网页版或其它设备同步。</view><button class="reset" bindtap="reset">重置全部数据</button></view><view wx:if="{{apkValidation}}" class="section"><button bindtap="apkUpdate">应用更新验证</button></view><view wx:if="{{warning}}" class="warning">{{warning}}</view></view>
