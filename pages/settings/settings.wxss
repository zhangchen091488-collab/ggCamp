 .heading { font-size: 44rpx; } .section { padding: 24rpx 0; border-bottom: 2rpx solid #20234f22; } .label { font-weight: 800; font-size: 30rpx; margin-bottom: 18rpx; } .counts { display: flex; gap: 14rpx; } .counts button { flex: 1; } .setting-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; } .guide { line-height: 1.7; font-size: 27rpx; background: #fff0ab; border-radius: 20rpx; padding: 24rpx; } .guide .label { margin-top: 24rpx; } .reset { margin-top: 24rpx; color: #b6354b; }
.partner-preview { position: relative; margin-bottom: 18rpx; border: 5rpx solid #20234f; border-radius: 38rpx; overflow: hidden; background: linear-gradient(#ffe6ef, #eef2ff); }
.partner-preview .partner-name { position: absolute; left: 16rpx; top: 14rpx; z-index: 5; font-size: 22rpx; font-weight: 800; padding: 5rpx 16rpx; border-radius: 30rpx; background: #20234f; color: #fff9ee; }

.book-picker {padding:22rpx 16rpx;border:3rpx solid #20234f;border-radius:20rpx;background:#fff0ab;font-size:28rpx;line-height:1.5;margin:18rpx 0;}
